{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test tests/unit.test.ts",
    "typecheck": "bun x tsc --noEmit",
    "migration:run": "bun src/migrate.ts up",
    "migration:revert": "bun src/migrate.ts down",
    "test:integration": "bun test tests/integration.test.ts",
    "test:http": "bun test tests/http.test.ts",
    "test:all": "bun test tests/unit.test.ts tests/integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.900.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "7.4.2",
    "decimal.js": "^10.6.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "bun-types": "^1.2.23",
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  }
}
